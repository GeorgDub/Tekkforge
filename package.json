{
  "name": "tekkforge",
  "version": "0.1.0",
  "description": "TekkForge — KORG ESX-1 → Electribe 2 Sampler Converter (.esx → .e2sallpat + .all)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "tekkforge": "dist/cli.mjs"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm build:cli && pnpm build:gui",
    "build:cli": "node scripts/build-cli.mjs",
    "build:gui": "vite build",
    "dev": "vite",
    "convert": "node dist/cli.mjs convert"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.1.0"
  }
}
